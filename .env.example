# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for production.

# Portfolio API that serves /projects and /experiences (optional; this is the default)
NEXT_PUBLIC_API_URL=https://portfolio-api-three-zeta.vercel.app/api

# Contact form (Gmail): SMTP_PASS must be a Google "App password", not your login password.
SMTP_USER=you@gmail.com
SMTP_PASS=
# Where contact messages are delivered (defaults to SMTP_USER)
CONTACT_RECEIVER=
